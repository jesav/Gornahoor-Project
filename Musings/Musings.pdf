  <rdf:Description rdf:about ='uuid:880f115b-f8b5-ae9d-b707-81b1dd2c6caf' xmlns:Iptc4xmpExt ='http://iptc.org/std/Iptc4xmpExt/2008-02-29/'>
   <Iptc4xmpExt:ArtworkOrObject>
    <rdf:Bag>
     <rdf:li rdf:parseType ='Resource'>
      <Iptc4xmpExt:AOTitle>
       <rdf:Alt>
        <rdf:li xml:lang ='x-default'>Petrarch and Laura de Noves</rdf:li>
       </rdf:Alt>
      </Iptc4xmpExt:AOTitle>
      <Iptc4xmpExt:AODateCreated>1510</Iptc4xmpExt:AODateCreated>
      <Iptc4xmpExt:AOCreator>
       <rdf:Seq>
        <rdf:li>Italian (Venetian) School</rdf:li>
       </rdf:Seq>
      </Iptc4xmpExt:AOCreator>
      <Iptc4xmpExt:AOSource>The Ashmolean Museum of Art and Archaeology </Iptc4xmpExt:AOSource>
      <Iptc4xmpExt:AOSourceInvNo>WA1897.22</Iptc4xmpExt:AOSourceInvNo>
      <Iptc4xmpExt:AOCopyrightNotice>Photo Credit: The Ashmolean Museum of Art and Archaeology</Iptc4xmpExt:AOCopyrightNotice>
      <Iptc4xmpExt:AOCreatorID>
       <rdf:Seq>
        <rdf:li></rdf:li>
       </rdf:Seq>
      </Iptc4xmpExt:AOCreatorID>
      <Iptc4xmpExt:AOCircaDateCreated>c. 1510</Iptc4xmpExt:AOCircaDateCreated>
      <Iptc4xmpExt:AOPhysicalDescription>
       <rdf:Alt>
        <rdf:li xml:lang ='x-default'>oil on canvas;  56 x 70 cm</rdf:li>
       </rdf:Alt>
      </Iptc4xmpExt:AOPhysicalDescription>
      <Iptc4xmpExt:AOContentDescription>
       <rdf:Alt>
        <rdf:li xml:lang ='x-default'>Many portraits are known of the poet Petrarch (1304-1374), from early manuscripts of his work, but none is known of his beloved, Laura (1307/8-1348), here depicted with a laurel branch, an attribute of poetry. The source for the portraits is a fifteenth-century Tuscan manuscript in which the subjects are depicted separately. The unknown artist, whose style is close to Bartolomeo Veneto, may have known these or copies of them.</rdf:li>
       </rdf:Alt>
      </Iptc4xmpExt:AOContentDescription>
      <Iptc4xmpExt:AOSourceInvURL>
       <rdf:Seq>
        <rdf:li>http://www.artuk.org/artworks/petrarch-and-laura-de-noves-141634</rdf:li>
       </rdf:Seq>
      </Iptc4xmpExt:AOSourceInvURL>
     </rdf:li>
    </rdf:Bag>
   </Iptc4xmpExt:ArtworkOrObject>
  </rdf:Description>
